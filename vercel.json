{
  "version": 2,
  "builds": [
    {
      "src": "index.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": [
          "client/dist/**",
          "node_modules/react/**",
          "node_modules/react-dom/**",
          "node_modules/react-apexcharts/**",
          "node_modules/@babel/**",
          "node_modules/tailwindcss/**"
        ]
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "/index.js"
    }
  ]
}
